# Copiez ce fichier vers backend/.env et complétez-le.
# .env n'est jamais versionné : il contient des mots de passe.

NODE_ENV=development
PORT=3001

# --- Base MySQL -----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hmgcde
DB_PASSWORD=
DB_NAME=hmgcde

# --- Sessions -------------------------------------------------------------
# Obligatoire en production. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Durée d'une session en millisecondes (12 h par défaut).
SESSION_MAX_AGE=43200000

# --- Amorçage (npm run seed) ---------------------------------------------
SEED_ADMIN_EMAIL=admin@hmgroup.fr
SEED_ADMIN_NAME=Administrateur HM
# Laisser vide : le script génère un mot de passe et l'affiche une seule fois.
SEED_ADMIN_PASSWORD=

# --- Divers ---------------------------------------------------------------
# Mettre à false pour ne pas appliquer les migrations au démarrage du serveur.
AUTO_MIGRATE=true
# Dossier des fichiers compilés du frontend (par défaut ../frontend/dist).
# FRONTEND_DIST=/home/ubuntu/achats-filial/public
