{
  "name": "hmgcde",
  "version": "3.0.0",
  "private": true,
  "displayName": "Achats filiales HM Group",
  "description": "Préparation, répartition et suivi des commandes de fournitures pour les sociétés du groupe HM.",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "setup": "npm --prefix backend run setup",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
